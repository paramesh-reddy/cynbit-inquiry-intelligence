# OpenAI API Configuration (Primary LLM Engine)
# Leave blank to run in Deterministic Fallback Mode without external LLM calls
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Optional Gemini API Key (injected automatically in AI Studio runtime if configured)
GEMINI_API_KEY=""

# Database Configuration
# Local development defaults to SQLite; swap to PostgreSQL URL in production
DATABASE_URL="sqlite:///./data/cynbit_inquiries.db"
DB_PATH="./data/cynbit_inquiries.db"

# Server & Frontend Configuration
PORT=3000
APP_URL="http://localhost:3000"
VITE_API_BASE_URL=""
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173"
